# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
ENV_FOR_VERCEL.txt
ENV_FOR_VERCEL.md
*.vercel.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor native projects (generate locally)
ios/
android/
.capacitor/

# Large generated video intermediates (not needed on Vercel)
public/videos/courses/_raw/
public/videos/courses/_silent/
public/videos/courses/_audio/
public/videos/sessions/_audio/
# 130 session mp4s (~1.8GB) — exceed git/Vercel limits; serve via CDN if needed
public/videos/sessions/*.mp4
