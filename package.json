{
  "name": "super-cube-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "supabase:verify": "node --env-file=.env.local scripts/verify-supabase.mjs",
    "supabase:orgs": "node --env-file=.env.local scripts/run-orgs-sql.mjs",
    "videos:upload": "node --env-file=.env.local scripts/upload-videos-to-supabase.mjs",
    "videos:upload:courses": "node --env-file=.env.local scripts/upload-videos-to-supabase.mjs --courses-only",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:add:push": "npm install @capacitor/push-notifications && npx cap sync",
    "test:e2e": "playwright test",
    "test:e2e:prod": "BASE_URL=https://www.super-cube.me playwright test",
    "test:e2e:install": "npx playwright install chromium"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
